{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npx prisma migrate deploy && npx prisma generate && npm run build",
  "crons": [
    {
      "path": "/api/cron/daily-tasks",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/create-snapshot",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/budget-report",
      "schedule": "0 4 12 * *"
    },
    {
      "path": "/api/cron/weekly-eating-out?utc=17",
      "schedule": "0 17 * * 6"
    },
    {
      "path": "/api/cron/weekly-eating-out?utc=18",
      "schedule": "0 18 * * 6"
    }
  ]
}
