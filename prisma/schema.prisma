// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Verification tokens for magic link authentication
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// User model - authentication entity
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Profile relation (1:1 optional)
  profile Profile?

  // Legacy relations (kept during migration, will be removed later)
  stockAccounts     StockAccount[]
  pensionAccounts   PensionAccount[]
  miscAssets        MiscAsset[]
  netWorthSnapshots NetWorthSnapshot[]

  @@map("users")
}

// Profile - represents a person whose finances are tracked
// Can be linked to a User (for login) or standalone (for family members)
model Profile {
  id        String   @id @default(cuid())
  name      String
  image     String?
  color     String?  @default("#3b82f6") // UI accent color for identification
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Optional User link (null for non-login profiles like children)
  userId String? @unique @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Household memberships (many-to-many)
  householdMemberships HouseholdMember[]

  // Asset ownership (many-to-many via junction tables)
  stockAccountOwners   StockAccountOwner[]
  pensionAccountOwners PensionAccountOwner[]
  miscAssetOwners      MiscAssetOwner[]

  // Budget transactions attributed to this profile
  budgetTransactions BudgetTransaction[]

  // Insurance policies attributed to this profile
  insurancePolicies InsurancePolicy[]

  @@map("profiles")
}

// Household - groups profiles together (family/unit)
model Household {
  id           String   @id @default(cuid())
  name         String
  description  String?
  // Phone number in E.164 form (e.g. +972501234567). Used by the "Ask partner on
  // WhatsApp" button on a transaction to deep-link into a wa.me chat.
  partnerPhone String?  @map("partner_phone")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Members
  members HouseholdMember[]

  // Budget module relations
  budgetCategoryGroups BudgetCategoryGroup[]
  riseupCategories     RiseupCategory[]
  payeeCategoryRules   PayeeCategoryRule[]

  // Insurance module
  insurancePolicies InsurancePolicy[]

  // Shopping module
  shoppingCategories ShoppingCategory[]
  shoppingItems      ShoppingItem[]
  shoppingCartItems  ShoppingCartItem[]
  shoppingDeliveries ShoppingDelivery[]

  // Moneytor module
  moneytorTransactions     MoneytorTransaction[]
  moneytorStockHoldings    MoneytorStockHolding[]
  moneytorStockSnapshots   MoneytorStockSnapshot[]
  moneytorAccounts         MoneytorAccount[]
  moneytorAccountSnapshots MoneytorAccountSnapshot[]
  moneytorPensionFunds     MoneytorPensionFund[]
  moneytorPensionSnapshots MoneytorPensionSnapshot[]

  // Budget settings
  ccGenericPayeeNames CcGenericPayeeName[]
  budgetAccountNames  BudgetAccountName[]

  @@map("households")
}

// CcGenericPayeeName - payee names that represent generic credit card charges in bank feeds.
// When a transaction with one of these names is imported alongside a transaction with the
// same amount within a 5-day window, the generic one is treated as a duplicate and skipped.
model CcGenericPayeeName {
  id          String   @id @default(cuid())
  name        String
  householdId String   @map("household_id")
  createdAt   DateTime @default(now()) @map("created_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, name])
  @@index([householdId])
  @@map("cc_generic_payee_names")
}

// BudgetAccountName - maps a transaction's payment identifier (e.g. Moneytor's account id
// suffix or a credit-card identifier from CSV imports) to a human-friendly account name.
// Used to display a recognizable account name in the transaction details instead of the raw,
// opaque identifier stored on BudgetTransaction.paymentIdentifier.
model BudgetAccountName {
  id            String   @id @default(cuid())
  accountNumber String   @map("account_number") // matches BudgetTransaction.paymentIdentifier
  name          String // friendly name
  householdId   String   @map("household_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, accountNumber])
  @@index([householdId])
  @@map("budget_account_names")
}

// HouseholdMember - junction table with role
enum HouseholdRole {
  owner
  admin
  member
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String        @map("household_id")
  profileId   String        @map("profile_id")
  role        HouseholdRole @default(member)
  joinedAt    DateTime      @default(now()) @map("joined_at")

  // Relations
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([householdId, profileId])
  @@map("household_members")
}

// Junction tables for asset ownership (supports multi-profile ownership)
model StockAccountOwner {
  id        String @id @default(cuid())
  accountId String @map("account_id")
  profileId String @map("profile_id")

  account StockAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  profile Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([accountId, profileId])
  @@map("stock_account_owners")
}

model PensionAccountOwner {
  id        String @id @default(cuid())
  accountId String @map("account_id")
  profileId String @map("profile_id")

  account PensionAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  profile Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([accountId, profileId])
  @@map("pension_account_owners")
}

model MiscAssetOwner {
  id        String @id @default(cuid())
  assetId   String @map("asset_id")
  profileId String @map("profile_id")

  asset   MiscAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  profile Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([assetId, profileId])
  @@map("misc_asset_owners")
}

// Stock Portfolio Models
model StockAccount {
  id        String   @id @default(cuid())
  name      String   // e.g., "Fidelity Brokerage", "Robinhood"
  broker    String?  // e.g., "Fidelity", "Robinhood", "Interactive Brokers"
  currency  String   @default("USD") // Account currency (USD, ILS, EUR, etc.)
  userId    String?  @map("user_id") // Legacy - nullable during migration
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Legacy relation (kept during migration)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // New ownership relation
  owners       StockAccountOwner[]
  holdings     StockHolding[]
  cashBalances StockAccountCash[]

  @@map("stock_accounts")
}

// Cash balance in a stock account - supports multiple currencies
model StockAccountCash {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  currency  String   // e.g., "USD", "ILS", "EUR"
  amount    Decimal  @db.Decimal(18, 2) // Cash balance in this currency
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account StockAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, currency]) // One balance per currency per account
  @@map("stock_account_cash")
}

model StockHolding {
  id           String   @id @default(cuid())
  symbol       String   // Stock ticker symbol (e.g., "AAPL", "GOOGL")
  name         String?  // Full stock name (e.g., "Apple Inc.")
  taseSymbol   String?  @map("tase_symbol") // TASE equivalent symbol for dual-listed stocks
  quantity     Decimal  @db.Decimal(18, 8) // Number of shares (supports fractional)
  avgCostBasis Decimal  @map("avg_cost_basis") @db.Decimal(18, 4) // Average cost per share
  accountId    String   @map("account_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  account StockAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, symbol]) // One holding per symbol per account
  @@map("stock_holdings")
}

model StockPriceHistory {
  id        String   @id @default(cuid())
  symbol    String   // Stock ticker symbol
  price     Decimal  @db.Decimal(18, 4) // Current/cached price
  timestamp DateTime @default(now()) // When this price was fetched

  @@unique([symbol, timestamp])
  @@index([symbol])
  @@map("stock_price_history")
}

// Pension/Hishtalmut Models
enum PensionAccountType {
  pension
  hishtalmut
}

model PensionAccount {
  id             String             @id @default(cuid())
  type           PensionAccountType
  providerName   String             @map("provider_name") // e.g., "Meitav", "Altshuler Shaham"
  accountName    String             @map("account_name")  // User-defined name
  accountNumber  String?            @map("account_number") // Institution account number (from PDF)
  currentValue   Decimal            @map("current_value") @db.Decimal(18, 2) // Current total value
  feeFromDeposit Decimal            @map("fee_from_deposit") @db.Decimal(5, 4) // Fee % from each deposit
  feeFromTotal   Decimal            @map("fee_from_total") @db.Decimal(5, 4) // Annual management fee %
  userId         String?            @map("user_id") // Legacy - nullable during migration
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  // Legacy relation (kept during migration)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // New ownership relation
  owners   PensionAccountOwner[]
  deposits PensionDeposit[]

  @@map("pension_accounts")
}

model PensionDeposit {
  id          String   @id @default(cuid())
  depositDate DateTime @map("deposit_date") @db.Date // When money was deposited
  salaryMonth DateTime @map("salary_month") @db.Date // Which month's salary (first of month)
  amount      Decimal  @db.Decimal(18, 2) // Deposit amount
  employer    String   // Company name
  accountId   String   @map("account_id")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  account PensionAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([salaryMonth])
  @@map("pension_deposits")
}

// Misc. Assets / Debt Models
enum MiscAssetType {
  bank_deposit
  loan
  mortgage
  child_savings
}

model MiscAsset {
  id             String        @id @default(cuid())
  type           MiscAssetType
  name           String                                                   // User-defined name
  currentValue   Decimal       @map("current_value") @db.Decimal(18, 2)   // Positive for assets, negative for debts
  interestRate   Decimal       @map("interest_rate") @db.Decimal(5, 4)    // Annual % (0.05 = 5%)
  monthlyPayment Decimal?      @map("monthly_payment") @db.Decimal(18, 2) // For loans/mortgages
  monthlyDeposit Decimal?      @map("monthly_deposit") @db.Decimal(18, 2) // For savings plans
  maturityDate   DateTime?     @map("maturity_date") @db.Date             // When deposit matures or loan ends
  userId         String?       @map("user_id") // Legacy - nullable during migration
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  // Legacy relation (kept during migration)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // New ownership relation
  owners MiscAssetOwner[]

  // Mortgage tracks (only used for mortgage type)
  mortgageTracks MortgageTrack[]

  @@index([userId])
  @@map("misc_assets")
}

// Mortgage Track - represents a single track/portion of a mortgage with its own terms
model MortgageTrack {
  id             String    @id @default(cuid())
  mortgageId     String    @map("mortgage_id")
  name           String                                               // Track name (e.g., "Fixed Rate", "Prime + 1%")
  amount         Decimal   @db.Decimal(18, 2)                         // Outstanding balance for this track
  interestRate   Decimal   @map("interest_rate") @db.Decimal(5, 4)    // Annual % for this track
  monthlyPayment Decimal?  @map("monthly_payment") @db.Decimal(18, 2) // Monthly payment for this track
  maturityDate   DateTime? @map("maturity_date") @db.Date             // When this track ends
  sortOrder      Int       @default(0) @map("sort_order")             // For ordering tracks
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relation to parent mortgage
  mortgage MiscAsset @relation(fields: [mortgageId], references: [id], onDelete: Cascade)

  @@index([mortgageId])
  @@map("mortgage_tracks")
}

// Net Worth Snapshots - bi-weekly historical records for graph
model NetWorthSnapshot {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  date      DateTime @db.Date // Snapshot date (1st or 15th of month)
  netWorth  Decimal  @map("net_worth") @db.Decimal(18, 2)
  portfolio Decimal  @db.Decimal(18, 2) // Stock portfolio value
  pension   Decimal  @db.Decimal(18, 2) // Total pension/hishtalmut value
  assets    Decimal  @db.Decimal(18, 2) // Net misc assets value (assets - debts)
  createdAt DateTime @default(now()) @map("created_at")

  // Relation to User for referential integrity
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date]) // One snapshot per user per date
  @@index([userId])
  @@index([date])
  @@map("net_worth_snapshots")
}

// ============================================
// BUDGET MODULE - Monthly Budget Tracking
// ============================================

enum TransactionType {
  income
  expense
}

enum TransactionSource {
  manual
  bank_import
  credit_card_import
  moneytor_sync
}

enum PaymentMethod {
  cash
  credit_card
  bank_transfer
  check
  other
}

// Riseup Categories - known categories from Riseup CSV imports
// Each can be mapped to a budget category; deleted ones won't be re-added on import
model RiseupCategory {
  id               String          @id @default(cuid())
  name             String // Hebrew category name from Riseup
  isDeleted        Boolean         @default(false) @map("is_deleted")
  budgetCategoryId String?         @map("budget_category_id")
  householdId      String          @map("household_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  // Relations
  budgetCategory BudgetCategory? @relation(fields: [budgetCategoryId], references: [id], onDelete: SetNull)
  household      Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, name]) // One entry per Riseup category per household
  @@index([householdId])
  @@index([budgetCategoryId])
  @@map("riseup_categories")
}

// Budget Category Groups - organize categories into logical groups
model BudgetCategoryGroup {
  id          String   @id @default(cuid())
  name        String
  sortOrder   Int      @default(0) @map("sort_order")
  householdId String   @map("household_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  household  Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  categories BudgetCategory[]

  @@unique([householdId, name]) // Unique group names per household
  @@index([householdId])
  @@map("budget_category_groups")
}

// Budget Categories - individual budget categories within groups
model BudgetCategory {
  id          String   @id @default(cuid())
  name        String
  groupId     String   @map("group_id")
  budget      Decimal? @db.Decimal(18, 2) // Monthly budget amount (null = no budget)
  isMust      Boolean  @default(false) @map("is_must") // Essential vs discretionary
  sortOrder   Int      @default(0) @map("sort_order")
  householdId String   @map("household_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  group              BudgetCategoryGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  transactions       BudgetTransaction[]
  payees             BudgetPayee[]        // Payees with this as default category
  riseupCategories   RiseupCategory[]     // Riseup categories mapped to this category
  payeeCategoryRules PayeeCategoryRule[]  // Rules that auto-assign this category

  @@unique([groupId, name]) // Unique category names per group
  @@index([householdId])
  @@index([groupId])
  @@map("budget_categories")
}

// Budget Payees - who you transact with
model BudgetPayee {
  id            String   @id @default(cuid())
  name          String
  categoryId    String?  @map("category_id") // Default category for this payee
  neverDefault  Boolean  @default(false) @map("never_default") // If true, never set/prompt a default category for this payee
  isBlacklisted Boolean  @default(false) @map("is_blacklisted") // Soft-hide: row stays in DB but excluded from every user-facing query (transactions list, summaries, payee dropdowns, payee-rule application)
  householdId   String   @map("household_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  category     BudgetCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions BudgetTransaction[]

  @@unique([householdId, name]) // Unique payee names per household
  @@index([householdId])
  @@index([categoryId])
  @@index([householdId, isBlacklisted])
  @@map("budget_payees")
}

// Budget Tags - labels for transactions
model BudgetTag {
  id          String   @id @default(cuid())
  name        String
  color       String   @default("#3B82F6") // Hex color code
  householdId String   @map("household_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  transactionTags BudgetTransactionTag[]

  @@unique([householdId, name]) // Unique tag names per household
  @@index([householdId])
  @@map("budget_tags")
}

// Budget Transactions - income and expense records
model BudgetTransaction {
  id                    String            @id @default(cuid())
  type                  TransactionType
  transactionDate       DateTime          @map("transaction_date") @db.Date
  paymentDate           DateTime?         @map("payment_date") @db.Date // For credit cards
  amountIls             Decimal           @map("amount_ils") @db.Decimal(18, 2)
  currency              String            @default("ILS") // Original currency
  amountOriginal        Decimal           @map("amount_original") @db.Decimal(18, 2) // Amount in original currency
  categoryId            String?           @map("category_id")
  payeeId               String?           @map("payee_id")
  paymentMethod         PaymentMethod     @default(credit_card) @map("payment_method")
  paymentNumber         Int?              @map("payment_number") // For installments (e.g., 2 of 6)
  totalPayments         Int?              @map("total_payments") // Total installments
  notes                 String?
  source                TransactionSource @default(manual)
  isRecurring           Boolean           @default(false) @map("is_recurring")
  isSplit               Boolean           @default(false) @map("is_split") // Is this a parent split transaction?
  originalTransactionId String?           @map("original_transaction_id") // Reference to parent if this is a split child
  paymentIdentifier     String?           @map("payment_identifier") // External payment identifier (e.g., credit card last 4 digits)
  excludedFromFlow      Boolean           @default(false) @map("excluded_from_flow") // Excluded from cashflow analysis
  isDeleted             Boolean           @default(false) @map("is_deleted") // Soft delete - kept for duplicate detection on import
  profileId             String?           @map("profile_id") // Which household member made the transaction
  householdId           String            @map("household_id")
  moneytorId            String?           @unique @map("moneytor_id") // Set when promoted from moneytor_transactions; natural dedup key for sync
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  // Relations
  category        BudgetCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  payee           BudgetPayee?           @relation(fields: [payeeId], references: [id], onDelete: SetNull)
  profile         Profile?               @relation(fields: [profileId], references: [id], onDelete: SetNull)
  tags            BudgetTransactionTag[]
  // Self-relation for split transactions
  originalTransaction BudgetTransaction?   @relation("SplitTransactions", fields: [originalTransactionId], references: [id], onDelete: Cascade)
  splitChildren       BudgetTransaction[]  @relation("SplitTransactions")

  @@index([householdId])
  @@index([householdId, isDeleted])
  @@index([householdId, isDeleted, transactionDate])
  @@index([transactionDate])
  @@index([categoryId])
  @@index([payeeId])
  @@index([profileId])
  @@index([originalTransactionId])
  @@map("budget_transactions")
}

// Payee Category Rules - auto-categorize payees by name pattern matching
model PayeeCategoryRule {
  id               String   @id @default(cuid())
  name             String // Human-readable rule name (e.g., "Supermarkets")
  operator         String // Match operator: contains, starts_with, ends_with, equals
  value            String // Match value (e.g., "spotify")
  categoryId       String?  @map("category_id") // Null when markNeverDefault is true
  markNeverDefault Boolean  @default(false) @map("mark_never_default") // If true, mark matching payees as neverDefault instead of assigning a category
  sortOrder        Int      @default(0) @map("sort_order") // Priority order (lower = higher priority)
  isActive         Boolean  @default(true) @map("is_active")
  householdId      String   @map("household_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  category  BudgetCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  household Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([categoryId])
  @@map("payee_category_rules")
}

// Junction table for transaction tags (many-to-many)
model BudgetTransactionTag {
  id            String @id @default(cuid())
  transactionId String @map("transaction_id")
  tagId         String @map("tag_id")

  // Relations
  transaction BudgetTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         BudgetTag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([transactionId, tagId])
  @@index([transactionId])
  @@index([tagId])
  @@map("budget_transaction_tags")
}

// ============================================
// INSURANCE MODULE
// ============================================

model InsurancePolicy {
  id                 String   @id @default(cuid())
  profileId          String   @map("profile_id")
  householdId        String   @map("household_id")
  mainBranch         String   @map("main_branch")
  subBranch          String?  @map("sub_branch")
  productType        String?  @map("product_type")
  company            String?  @map("company")
  insurancePeriod    String?  @map("insurance_period")
  additionalDetails  String?  @map("additional_details")
  premiumIls         Decimal? @map("premium_ils") @db.Decimal(12, 2)
  premiumType        String?  @map("premium_type")
  policyNumber       String?  @map("policy_number")
  planClassification String?  @map("plan_classification")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([profileId])
  @@map("insurance_policies")
}

// ============================================
// SHOPPING MODULE
// ============================================

model ShoppingCategory {
  id          String   @id @default(cuid())
  name        String
  sortOrder   Int      @default(0) @map("sort_order")
  householdId String   @map("household_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     ShoppingItem[]

  @@unique([householdId, name])
  @@index([householdId])
  @@map("shopping_categories")
}

model ShoppingItem {
  id              String    @id @default(cuid())
  name            String
  nameHe          String?   @map("name_he") // Hebrew alternate name for bilingual search
  categoryId      String    @map("category_id")
  isDefault       Boolean   @default(false) @map("is_default") // Auto-added to every new cart
  lastPurchasedAt DateTime? @map("last_purchased_at") // For time-based warnings
  warningDays     Int?      @map("warning_days") // Days threshold before warning (null = no warning)
  householdId     String    @map("household_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  category  ShoppingCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  household Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  cartItems ShoppingCartItem[]

  @@unique([householdId, name])
  @@index([householdId])
  @@index([categoryId])
  @@map("shopping_items")
}

// Delivery records - track when carts were marked as delivered
model ShoppingDelivery {
  id          String   @id @default(cuid())
  deliveredAt DateTime @default(now()) @map("delivered_at")
  itemCount   Int      @map("item_count")
  householdId String   @map("household_id")
  createdAt   DateTime @default(now()) @map("created_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("shopping_deliveries")
}

model ShoppingCartItem {
  id          String   @id @default(cuid())
  itemId      String   @map("item_id")
  quantity    Int      @default(1)
  checked     Boolean  @default(false)
  householdId String   @map("household_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  item      ShoppingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, itemId])
  @@index([householdId])
  @@map("shopping_cart_items")
}

// Moneytor Transactions - read-only mirror of transactions pulled from Moneytor API
model MoneytorTransaction {
  id              String   @id // Moneytor's ULID; natural PK for upsert
  transactionDate DateTime @map("transaction_date") @db.Date
  amount          Decimal  @db.Decimal(18, 2) // Signed: negative = expense, positive = income
  currency        String   @default("ILS")
  description     String
  category        String // Raw Moneytor category string (e.g. BANK_TRANSFER)
  accountId       String   @map("account_id")
  type            String // Moneytor account type (e.g. CHECKING)
  // Set by force-resync when a fresh row is a fuzzy match for a previously-
  // stored Moneytor id (Moneytor may issue new ids when they fix data).
  // Audit-only: by the time this is set, the referenced old row is already
  // deleted. Lets you spot which transactions were carried across a resync.
  replacesMoneytorId String? @map("replaces_moneytor_id")
  householdId     String   @map("household_id")
  syncedAt        DateTime @default(now()) @map("synced_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([householdId, transactionDate])
  @@index([category])
  @@map("moneytor_transactions")
}

// Moneytor Stock Holdings - mirror of share-form assets returned by Moneytor /assets.
// One row per holding inside an account's stocksData[].
model MoneytorStockHolding {
  id                String    @id @default(cuid())
  productId         String    @map("product_id") // Moneytor product id (parent account)
  accountName       String    @map("account_name")
  broker            String?
  stockName         String    @map("stock_name") // ticker / symbol
  amount            Decimal   @db.Decimal(20, 8) // units held
  purchasePrice     Decimal?  @map("purchase_price") @db.Decimal(20, 4)
  purchaseDate      DateTime? @map("purchase_date") @db.Date
  stockPrice        Decimal   @map("stock_price") @db.Decimal(20, 4)
  currency          String
  totalWorthInBase  Decimal   @map("total_worth_in_base") @db.Decimal(18, 2)
  accountCash       Decimal?  @map("account_cash") @db.Decimal(18, 2) // cash on the parent account
  householdId       String    @map("household_id")
  syncedAt          DateTime  @default(now()) @map("synced_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, productId, stockName])
  @@index([householdId])
  @@index([householdId, productId])
  @@map("moneytor_stock_holdings")
}

// Daily snapshot of each Moneytor holding. Written on every sync; idempotent per (date, holding).
// Used to draw value-over-time charts since Moneytor's API doesn't expose history.
model MoneytorStockSnapshot {
  id               String   @id @default(cuid())
  snapshotDate     DateTime @map("snapshot_date") @db.Date
  productId        String   @map("product_id")
  accountName      String   @map("account_name")
  stockName        String   @map("stock_name")
  amount           Decimal  @db.Decimal(20, 8)
  stockPrice       Decimal  @map("stock_price") @db.Decimal(20, 4)
  currency         String
  totalWorthInBase Decimal  @map("total_worth_in_base") @db.Decimal(18, 2)
  accountCash      Decimal? @map("account_cash") @db.Decimal(18, 2)
  householdId      String   @map("household_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, snapshotDate, productId, stockName])
  @@index([householdId, snapshotDate])
  @@map("moneytor_stock_snapshots")
}

// Persistent log of cron invocations — one row per run. Survives Vercel's short
// runtime-log retention window and lets us query "did sync fail last Tuesday?"
model CronRunLog {
  id            String   @id @default(cuid())
  cronPath      String   @map("cron_path") // e.g. "/api/cron/daily-tasks"
  startedAt     DateTime @map("started_at")
  completedAt   DateTime @map("completed_at")
  durationMs    Int      @map("duration_ms")
  success       Boolean
  errorMessage  String?  @map("error_message")
  results       Json?    // raw response body (per-task counts, failures, etc.)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([cronPath, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
  @@map("cron_run_logs")
}

// Moneytor accounts — banks, debts, and (extensible) other non-share product forms.
// One row per Moneytor product. Updated on every sync.
model MoneytorAccount {
  id             String    @id @default(cuid())
  productId      String    @map("product_id")
  form           String // 'bank' | 'debt' | future forms
  name           String
  institution    String?
  subtype        String? // bank: 'balance'|'saving'; debt: 'loan'|'mortgage'|'credit_card'
  accountNumber  String?   @map("account_number")
  currency       String
  balanceInBase  Decimal   @map("balance_in_base") @db.Decimal(18, 2) // signed: positive=asset, negative=debt
  interestRate   Decimal?  @map("interest_rate") @db.Decimal(8, 4)
  maturityDate   DateTime? @map("maturity_date") @db.Date
  monthlyPayment Decimal?  @map("monthly_payment") @db.Decimal(18, 2)
  customSubtitle String?   @map("custom_subtitle") // user-editable label shown under the account name
  rawData        Json?     @map("raw_data")
  householdId    String    @map("household_id")
  syncedAt       DateTime  @default(now()) @map("synced_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, productId])
  @@index([householdId])
  @@index([householdId, form])
  @@map("moneytor_accounts")
}

// Daily snapshot per Moneytor account. Idempotent per (household, date, productId).
model MoneytorAccountSnapshot {
  id            String   @id @default(cuid())
  snapshotDate  DateTime @map("snapshot_date") @db.Date
  productId     String   @map("product_id")
  form          String
  name          String
  balanceInBase Decimal  @map("balance_in_base") @db.Decimal(18, 2)
  currency      String
  householdId   String   @map("household_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, snapshotDate, productId])
  @@index([householdId, snapshotDate])
  @@map("moneytor_account_snapshots")
}

// Moneytor pension funds — covers both pension ("קרן פנסיה", sugKupa=1) and
// hishtalmut ("קרן השתלמות", sugKupa=3). Kept as separate rows per route — a
// single fund with multiple investment tracks appears multiple times. Uniqueness
// is (household, productId, routeName) so each track survives.
model MoneytorPensionFund {
  id                              String    @id @default(cuid())
  productId                       String    @map("product_id") // Moneytor product id
  routeName                       String    @map("route_name") // investment track name
  routeCode                       String?   @map("route_code")
  // Identity
  name                            String
  institution                     String?
  productType                     String    @map("product_type") // "קרן פנסיה" | "קרן השתלמות"
  sugKupa                         Int?      @map("sug_kupa") // 1=pension, 3=hishtalmut
  sugKerenPensia                  String?   @map("sug_keren_pensia")
  accountNumber                   String?   @map("account_number")
  accountOwner                    String?   @map("account_owner")
  fundId                          String?   @map("fund_id")
  fundOpeningDate                 DateTime? @map("fund_opening_date") @db.Date
  // Balance
  amount                          Decimal   @db.Decimal(18, 2)
  currency                        String    @default("ILS")
  balanceInBase                   Decimal   @map("balance_in_base") @db.Decimal(18, 2)
  // Performance
  profitsFromLastYear             Decimal?  @map("profits_from_last_year") @db.Decimal(8, 4)
  // Deposits
  monthlyDepositEmployee          Decimal?  @map("monthly_deposit_employee") @db.Decimal(18, 2)
  monthlyDepositEmployer          Decimal?  @map("monthly_deposit_employer") @db.Decimal(18, 2)
  monthlyDepositSum               Decimal?  @map("monthly_deposit_sum") @db.Decimal(18, 2)
  depositFrequency                String?   @map("deposit_frequency")
  employerProvisionPct            Decimal?  @map("employer_provision_pct") @db.Decimal(8, 4)
  compensationProvisionPct        Decimal?  @map("compensation_provision_pct") @db.Decimal(8, 4)
  // Fees
  mgmtFeeFromSavings              Decimal?  @map("mgmt_fee_from_savings") @db.Decimal(8, 4)
  mgmtFeeFromDeposit              Decimal?  @map("mgmt_fee_from_deposit") @db.Decimal(8, 4)
  // Pension projections (null for hishtalmut)
  projectedMonthlyPension         Decimal?  @map("projected_monthly_pension") @db.Decimal(18, 2)
  projectedSavingsWithPremiums    Decimal?  @map("projected_savings_with_premiums") @db.Decimal(18, 2)
  projectedSavingsWithoutPremiums Decimal?  @map("projected_savings_without_premiums") @db.Decimal(18, 2)
  yearsToRetirement               Int?      @map("years_to_retirement")
  gilPrisha                       Int?      @map("gil_prisha")
  // Severance
  sumHafkadotPitsuyim             Decimal?  @map("sum_hafkadot_pitsuyim") @db.Decimal(18, 2)
  sumHafkadotLoPitsuyim           Decimal?  @map("sum_hafkadot_lo_pitsuyim") @db.Decimal(18, 2)
  pitzuimMaasikNochechi           Decimal?  @map("pitzuim_maasik_nochechi") @db.Decimal(18, 2)
  pitzuimMarkivLemas              Decimal?  @map("pitzuim_markiv_lemas") @db.Decimal(18, 2)
  // Owner
  gender                          String?
  taarichLeyda                    DateTime? @map("taarich_leyda") @db.Date
  matsavMishpachti                String?   @map("matsav_mishpachti")
  // Catch-all for unmodeled fields (full Moneytor record)
  rawData                         Json?     @map("raw_data")
  householdId                     String    @map("household_id")
  syncedAt                        DateTime  @default(now()) @map("synced_at")
  createdAt                       DateTime  @default(now()) @map("created_at")
  updatedAt                       DateTime  @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, productId, routeName])
  @@index([householdId])
  @@index([householdId, productType])
  @@map("moneytor_pension_funds")
}

// Monthly snapshot per pension/hishtalmut fund track. Snapshot date is the
// first of the month (UTC). Multiple syncs in the same month overwrite the
// same row, so the snapshot reflects the most recent observation for that
// month. Used to draw value-over-time charts.
model MoneytorPensionSnapshot {
  id                  String   @id @default(cuid())
  snapshotMonth       DateTime @map("snapshot_month") @db.Date // first of month
  productId           String   @map("product_id")
  routeName           String   @map("route_name")
  // identity (denormalized so snapshots survive fund deletion)
  name                String
  institution         String?
  productType         String   @map("product_type")
  // balance
  amount              Decimal  @db.Decimal(18, 2)
  balanceInBase       Decimal  @map("balance_in_base") @db.Decimal(18, 2)
  currency            String
  // useful monthly stats
  monthlyDepositSum   Decimal? @map("monthly_deposit_sum") @db.Decimal(18, 2)
  profitsFromLastYear Decimal? @map("profits_from_last_year") @db.Decimal(8, 4)
  householdId         String   @map("household_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, snapshotMonth, productId, routeName])
  @@index([householdId, snapshotMonth])
  @@map("moneytor_pension_snapshots")
}
